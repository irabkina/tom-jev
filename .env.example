# Copy to .env and fill in. .env is gitignored.

# TypeSafe (Jev) — key from https://console.typesafe.ai/
TYPESAFE_API_KEY= 

# Optional SDK overrides; defaults are https://api.typesafe.ai and jev-latest
# TYPESAFE_BASE_URL=
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Where experiment artifacts are written
JEV_RESULTS_DIR=results

# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
